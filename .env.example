# Copy to .env and fill in the providers you want. Any provider without a key
# still works if a visitor pastes their own key in Settings (unless disabled).
# With no keys at all, the app runs on the built-in offline demo writer.

# --- Model providers -------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Local models via Ollama (e.g. http://localhost:11434)
OLLAMA_BASE_URL=

# Provider used first when the page loads (openai, anthropic, gemini, groq, deepseek, openrouter, ollama, mock)
DEFAULT_PROVIDER=

# Override any model list without code changes, comma separated
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# ANTHROPIC_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5-5

# --- Token budget ----------------------------------------------------------
MAX_JD_CHARS=12000
MAX_OUTPUT_TOKENS=2200
CHAT_HISTORY_TURNS=6
CACHE_TTL_MS=21600000
CACHE_MAX_ENTRIES=200

# --- Server ----------------------------------------------------------------
PORT=8787
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=90000
# Let visitors use their own API keys (sent per request, never stored)
ALLOW_USER_KEYS=true
# Set to false to hide the offline demo writer in production
ENABLE_MOCK=true
